## @file
#  ACPI tables of the M4 MacBook Pro as SiliconNT presents it to Windows:
#  a machine with a standard GICv3, the virtual timer on INTID 27, PSCI over HVC.
#
#  The loader is MdeModulePkg/Universal/Acpi/AcpiPlatformDxe, which installs every
#  table in the firmware volume file named by PcdAcpiTableStorageFile. FILE_GUID
#  below is that PCD's default value.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = AcpiTables
  FILE_GUID                      = 7E374E25-8E01-4FEE-87F2-390C23C606CD
  MODULE_TYPE                    = USER_DEFINED
  VERSION_STRING                 = 1.0

[Sources]
  Madt.aslc
  Gtdt.aslc
  Fadt.aslc
  Dbg2.aslc
  Dsdt.asl

[Packages]
  ArmPkg/ArmPkg.dec
  ArmPlatformPkg/ArmPlatformPkg.dec
  EmbeddedPkg/EmbeddedPkg.dec
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  AppleSiliconPkg/AppleSiliconPkg.dec
  SiliconNTPkg/SiliconNTPkg.dec

[FixedPcd]
  gEfiMdeModulePkgTokenSpaceGuid.PcdAcpiDefaultCreatorRevision
  gEfiMdeModulePkgTokenSpaceGuid.PcdAcpiDefaultOemRevision
  gArmTokenSpaceGuid.PcdArmArchTimerSecIntrNum
  gArmTokenSpaceGuid.PcdArmArchTimerIntrNum
  gArmTokenSpaceGuid.PcdArmArchTimerHypIntrNum
  gArmTokenSpaceGuid.PcdArmArchTimerVirtIntrNum
  gArmTokenSpaceGuid.PcdGicDistributorBase
  gArmTokenSpaceGuid.PcdGicRedistributorsBase
  gAppleSiliconPkgTokenSpaceGuid.PcdCoreCount
  gAppleSiliconPkgTokenSpaceGuid.PcdAppleUartBase
