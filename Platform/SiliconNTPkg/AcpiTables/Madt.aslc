/**
 * Copyright (c) 2023, amarioguy (AppleWOA authors).
 *
 * Module Name:
 *     Madt.aslc
 *
 * Abstract:
 *     Multiple APIC Description Table of the M4 MacBook Pro as SiliconNT presents it:
 *     ten cores, one GICv3 Distributor, one Redistributor range. The GIC is emulated
 *     by the EL2 layer.
 *
 * License:
 *     SPDX-License-Identifier: BSD-2-Clause-Patent OR MIT
 *
 * SiliconNT: derived from NT-for-ASi/apple_silicon_platforms_mu (861dcc490c56),
 * Silicon/Apple/T602XFamilyPkg/AcpiTables/MADT_Static.aslc.
 *
 * Where the values come from (SiliconNT docs):
 *   - Core numbers and the "reg" of each core: the machine's Apple device tree,
 *     docs/lab/2026-11-10-q3-macos-probes/ioreg-devicetree.log (cores 0-5 are
 *     efficiency cores with reg 0..5, cores 6-9 performance cores with reg 0x100..0x103).
 *   - MPIDR: read on the machine for cores 6 (0x10100), 0 (0x0) and 7 (0x10101),
 *     docs/lab/2026-11-13-vgic-dist-plan/gictest-3cpu.txt. The other seven follow the
 *     same pattern (reg, plus 0x10000 on performance cores) and have NOT been read.
 *   - The boot core is core 6 and must come first (ACPI 6.6, GICC structure).
 *   - Parked Address 0, GICD version 3, no ITS: docs/DESIGN.md.
 *   - The ACPI processor UID equals the m1n1 core number.
 */

#include <Library/AcpiLib.h>
#include <Library/ArmLib.h>
#include <Library/PcdLib.h>
#include <IndustryStandard/Acpi64.h>
#include <Acpi/AcpiHeader.h>

#define M4_CORE_COUNT  10

#if FixedPcdGet32 (PcdCoreCount) != M4_CORE_COUNT
  #error PcdCoreCount must be 10 for the M4 MacBook Pro
#endif

//
// Efficiency class: 0 for the efficiency cores, 1 for the performance cores.
//
#define M4_ECORE(Uid, Aff0)                                                  \
  EFI_ACPI_6_3_GICC_STRUCTURE_INIT (                                         \
    Uid, Uid, GET_MPIDR (0, 0, 0, Aff0), EFI_ACPI_6_4_GIC_ENABLED,           \
    0 /* PmuIrq */, 0 /* GicBase */, 0 /* GicVBase */, 0 /* GicHBase */,     \
    0 /* GsivId */, 0 /* GicRBase */, 0 /* Efficiency */, 0 /* SpeOvflIrq */)

#define M4_PCORE(Uid, Aff0)                                                  \
  EFI_ACPI_6_3_GICC_STRUCTURE_INIT (                                         \
    Uid, Uid, GET_MPIDR (0, 1, 1, Aff0), EFI_ACPI_6_4_GIC_ENABLED,           \
    0 /* PmuIrq */, 0 /* GicBase */, 0 /* GicVBase */, 0 /* GicHBase */,     \
    0 /* GsivId */, 0 /* GicRBase */, 1 /* Efficiency */, 0 /* SpeOvflIrq */)

#pragma pack (1)

typedef struct {
  EFI_ACPI_6_4_MULTIPLE_APIC_DESCRIPTION_TABLE_HEADER    Header;
  EFI_ACPI_6_4_GIC_STRUCTURE                             GicInterfaces[M4_CORE_COUNT];
  EFI_ACPI_6_4_GIC_DISTRIBUTOR_STRUCTURE                 GicDistributor;
  EFI_ACPI_6_4_GICR_STRUCTURE                            GicRedistributor;
} MULTIPLE_APIC_DESCRIPTION_TABLE;

#pragma pack ()

MULTIPLE_APIC_DESCRIPTION_TABLE  Madt = {
  {
    __ACPI_HEADER (
      EFI_ACPI_6_4_MULTIPLE_APIC_DESCRIPTION_TABLE_SIGNATURE,
      MULTIPLE_APIC_DESCRIPTION_TABLE,
      EFI_ACPI_6_4_MULTIPLE_APIC_DESCRIPTION_TABLE_REVISION
      ),
    0, // LocalApicAddress
    0, // Flags
  },
  {
    M4_PCORE (6, 0),   // boot core
    M4_PCORE (7, 1),
    M4_PCORE (8, 2),
    M4_PCORE (9, 3),
    M4_ECORE (0, 0),
    M4_ECORE (1, 1),
    M4_ECORE (2, 2),
    M4_ECORE (3, 3),
    M4_ECORE (4, 4),
    M4_ECORE (5, 5),
  },
  EFI_ACPI_6_0_GIC_DISTRIBUTOR_INIT (0, FixedPcdGet64 (PcdGicDistributorBase), 0, 3),
  {
    EFI_ACPI_6_4_GICR,                              // Type
    sizeof (EFI_ACPI_6_4_GICR_STRUCTURE),           // Length
    EFI_ACPI_RESERVED_WORD,                         // Reserved
    FixedPcdGet64 (PcdGicRedistributorsBase),       // DiscoveryRangeBaseAddress
    0x20000 * M4_CORE_COUNT                         // DiscoveryRangeLength
  }
};

//
// Reference the table being generated to prevent the optimizer from removing the
// data structure from the executable
//
VOID *CONST  ReferenceAcpiTable = &Madt;
