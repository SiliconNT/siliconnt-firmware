# Apple UART Serial Port Library INF Description File
# SPDX-License-Identifier: BSD-2-Clause-Patent
#
# SiliconNT: the flavour for the entry code (PrePi), which tells it the address.
# The three flavours of this library differ in how they learn the address of the
# port; see AppleUartBase.h.

[Defines]
  INF_VERSION    = 0x00010005
  FILE_GUID      = 25d06721-38ee-46ec-933d-d6295121675f
  BASE_NAME      = AppleUartSerialPortLibSec
  MODULE_TYPE    = BASE
  VERSION_STRING = 1.0
  LIBRARY_CLASS  = SerialPortLib|SEC

[Sources.common]
  AppleUartSerialPortLib.c
  AppleUartBase.h
  SecBase.c

[Packages]
  MdePkg/MdePkg.dec
  ArmPkg/ArmPkg.dec
  AppleSiliconPkg/AppleSiliconPkg.dec

[LibraryClasses]
  ArmLib
  IoLib
  CompilerIntrinsicsLib
